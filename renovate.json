{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Preserve Swift 6.2 compatibility; GzipSwift 7 requires Swift 6.3.",
      "matchManagers": [
        "swift"
      ],
      "matchPackageNames": [
        "1024jp/GzipSwift"
      ],
      "allowedVersions": "<7.0.0"
    },
    {
      "description": "Avoid unused public import diagnostics from OpenAPI Generator 1.13+ until upstream generation is warning-free.",
      "matchManagers": [
        "swift"
      ],
      "matchPackageNames": [
        "apple/swift-openapi-generator"
      ],
      "allowedVersions": "<1.13.0"
    }
  ]
}
